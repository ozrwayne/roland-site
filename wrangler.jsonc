{
	"main": "worker/index.js",
	"name": "rolandwayne",
  "compatibility_date": "2026-02-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
    "enabled": true
  },
	"send_email": [
		{
			"name": "CONTACT_EMAIL"
		}
	]
}
