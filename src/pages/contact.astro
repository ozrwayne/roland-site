---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { useTranslations } from '../i18n/utils';

export const prerender = false;

const t = useTranslations('zh');
const hostname = new URL(Astro.request.url).hostname;
const isLocal = hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1';
const turnstileSiteKey =
  Astro.locals.runtime?.env.TURNSTILE_SITE_KEY ||
  (isLocal ? '1x00000000000000000000AA' : '');
---

<BaseLayout
  title="联系"
  description="联系 Roland Wayne，讨论科研合作、教育咨询或 AI 系统构建。"
  lang="zh"
>
  <PageHero
    kicker="Contact / Collaboration"
    title="联系"
    subtitle={t.contact.subtitle}
  />

  <section class="contact-section">
    <div class="contact-shell">
      <aside class="contact-details" aria-labelledby="direct-contact-title">
        <div>
          <p class="section-kicker">Direct contact</p>
          <h2 id="direct-contact-title">直接联系</h2>
          <p class="contact-intro">如果您更习惯邮件，也可以直接写信。请在邮件中简要说明项目背景与希望讨论的问题。</p>
        </div>

        <dl class="contact-list">
          <div>
            <dt>{t.contact.email}</dt>
            <dd>
              <a href="mailto:contact@rolandwayne.com">contact@rolandwayne.com</a>
            </dd>
          </div>
          <div>
            <dt>{t.contact.location}</dt>
            <dd>{t.contact.locationValue}</dd>
          </div>
          <div>
            <dt>{t.contact.affiliation}</dt>
            <dd>{t.contact.affiliationValue}</dd>
          </div>
          <div>
            <dt>{t.contact.company}</dt>
            <dd>{t.contact.companyValue}</dd>
          </div>
        </dl>
      </aside>

      <div class="form-panel">
        <div class="form-heading">
          <div>
            <p class="section-kicker">Project brief</p>
            <h2>发起一次对话</h2>
          </div>
          <p><span aria-hidden="true">*</span> 为必填项</p>
        </div>

        <form id="contact-form" action="/api/contact" method="post" novalidate>
          <div class="form-grid">
            <div class="form-field">
              <label for="contact-name">姓名 <span aria-hidden="true">*</span></label>
              <input id="contact-name" name="name" type="text" maxlength="80" autocomplete="name" required />
            </div>

            <div class="form-field">
              <label for="contact-company">机构 / 公司 <span aria-hidden="true">*</span></label>
              <input id="contact-company" name="company" type="text" maxlength="120" autocomplete="organization" required />
            </div>

            <div class="form-field form-field-wide">
              <label for="contact-email">邮箱 <span aria-hidden="true">*</span></label>
              <input id="contact-email" name="email" type="email" maxlength="160" autocomplete="email" inputmode="email" required />
            </div>

            <div class="form-field">
              <label for="contact-stage">合作阶段 <span aria-hidden="true">*</span></label>
              <div class="select-wrap">
                <select id="contact-stage" name="projectStage" required>
                  <option value="" selected disabled>请选择当前阶段</option>
                  <option value="初步探索">初步探索</option>
                  <option value="需求梳理中">需求梳理中</option>
                  <option value="方案已经明确">方案已经明确</option>
                  <option value="准备近期启动">准备近期启动</option>
                  <option value="长期合作咨询">长期合作咨询</option>
                </select>
              </div>
            </div>

            <div class="form-field">
              <label for="contact-budget">预算范围 <span aria-hidden="true">*</span></label>
              <div class="select-wrap">
                <select id="contact-budget" name="budget" required>
                  <option value="" selected disabled>请选择预算范围</option>
                  <option value="尚未确定">尚未确定</option>
                  <option value="5 万人民币以内">5 万人民币以内</option>
                  <option value="5–20 万人民币">5–20 万人民币</option>
                  <option value="20–50 万人民币">20–50 万人民币</option>
                  <option value="50 万人民币以上">50 万人民币以上</option>
                  <option value="其他币种或范围">其他币种或范围</option>
                </select>
              </div>
            </div>

            <div class="form-field form-field-wide">
              <label for="contact-brief">需求简述 <span aria-hidden="true">*</span></label>
              <textarea
                id="contact-brief"
                name="brief"
                rows="3"
                maxlength="4000"
                placeholder="请简要说明您正在推进的项目、目前遇到的问题，以及希望获得的支持。"
                required></textarea>
            </div>
          </div>

          <div class="honeypot" aria-hidden="true">
            <label for="contact-website">网站</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="verification-row">
            {turnstileSiteKey ? (
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action="contact"
                data-theme="light"
                data-size="flexible"
                data-language="zh-cn"
              ></div>
            ) : (
              <p class="configuration-note">验证服务正在配置，请暂时直接发送邮件。</p>
            )}
          </div>

          <div class="form-actions">
            <button type="submit" disabled={!turnstileSiteKey}>
              <span class="button-label">发送简报</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </button>
            <p id="form-status" class="form-status" role="status" aria-live="polite">填写完整后即可发送</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = button?.querySelector<HTMLElement>('.button-label');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity() || !button || !buttonLabel || !status) return;

      button.disabled = true;
      buttonLabel.textContent = '发送中…';
      status.textContent = '正在安全发送您的信息';
      status.dataset.state = 'loading';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const result = (await response.json()) as { success?: boolean; message?: string };

        if (!response.ok || !result.success) {
          throw new Error(result.message || '发送失败，请稍后重试。');
        }

        form.reset();
        status.textContent = result.message || '信息已发送，我会尽快回复。';
        status.dataset.state = 'success';
        buttonLabel.textContent = '已发送';

        const turnstile = (window as typeof window & { turnstile?: { reset(): void } }).turnstile;
        turnstile?.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : '发送失败，请稍后重试。';
        status.dataset.state = 'error';
        button.disabled = false;
        buttonLabel.textContent = '重新发送';
      }
    });
  </script>
</BaseLayout>

<style>
  .contact-section {
    padding-block: clamp(4rem, 7vw, 7rem);
    background: var(--wis-paper);
  }

  .contact-shell {
    display: grid;
    grid-template-columns: minmax(13rem, 0.68fr) minmax(0, 1.65fr);
    gap: clamp(3.5rem, 7vw, 7.5rem);
    width: min(100%, 68rem);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
  }

  .section-kicker {
    margin: 0 0 0.7rem;
    color: var(--wis-blue);
    font-size: 0.72rem;
    font-weight: 680;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .contact-details {
    position: sticky;
    top: 4rem;
  }

  .contact-details h2,
  .form-heading h2 {
    margin: 0;
    color: var(--wis-navy);
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .contact-intro {
    margin: 1.2rem 0 0;
    color: var(--wis-copy);
    font-size: 0.93rem;
    line-height: 1.85;
  }

  .contact-list {
    display: grid;
    gap: 0;
    margin: 2.8rem 0 0;
  }

  .contact-list > div {
    padding-block: 1.2rem;
    border-top: 1px solid var(--wis-line);
  }

  .contact-list dt {
    margin-bottom: 0.35rem;
    color: var(--wis-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
  }

  .contact-list dd {
    margin: 0;
    color: var(--wis-copy);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .contact-list a {
    color: var(--wis-navy);
    text-decoration: none;
  }

  .contact-list a:hover {
    text-decoration: underline;
  }

  .form-panel {
    border: 1px solid var(--wis-line);
    background: #ffffff;
  }

  .form-heading {
    display: flex;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
    padding: 0.75rem;
    background: var(--wis-surface);
    border-bottom: 1px solid var(--wis-line);
  }

  .form-heading > p {
    flex: none;
    margin: 0 0 0.2rem;
    color: var(--wis-muted);
    font-size: 0.75rem;
  }

  .form-heading > p span,
  .form-field label span {
    color: var(--wis-blue);
  }

  #contact-form {
    padding: 0.75rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.85rem;
  }

  .form-field-wide {
    grid-column: 1 / -1;
  }

  .form-field label {
    display: block;
    margin-bottom: 0.18rem;
    color: var(--wis-navy);
    font-size: 0.72rem;
    font-weight: 670;
    letter-spacing: 0.035em;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    margin: 0;
    color: var(--wis-navy-deep);
    background: var(--wis-paper);
    border: 1px solid #c9d7e5;
    border-radius: 0;
    font: inherit;
    font-size: 0.94rem;
    line-height: 1.5;
    transition: border-color 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }

  .form-field input,
  .form-field select {
    min-height: 2.2rem;
    padding: 0.35rem 0.72rem;
  }

  .form-field textarea {
    min-height: 4.25rem;
    padding: 0.5rem 0.72rem;
    resize: vertical;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    background: #ffffff;
    border-color: var(--wis-blue);
    box-shadow: 0 0 0 3px rgb(163 209 224 / 35%);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #8a9bae;
    opacity: 1;
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    position: absolute;
    top: 50%;
    right: 1rem;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--wis-blue);
    border-bottom: 1.5px solid var(--wis-blue);
    pointer-events: none;
    content: '';
    transform: translateY(-70%) rotate(45deg);
  }

  .form-field select {
    padding-right: 2.5rem;
    appearance: none;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .verification-row {
    min-height: 4.1rem;
    margin-top: 0.45rem;
  }

  .cf-turnstile {
    width: min(100%, 19rem);
  }

  .configuration-note {
    margin: 0;
    padding: 1rem;
    color: var(--wis-copy);
    background: var(--wis-surface);
    border: 1px solid var(--wis-line);
    font-size: 0.85rem;
  }

  .form-actions {
    display: grid;
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    margin-top: 0.45rem;
    border-top: 1px solid var(--wis-line);
    border-right: 1px solid var(--wis-line);
    border-bottom: 1px solid var(--wis-line);
  }

  .form-actions button {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.8rem;
    padding: 0.58rem 0.95rem;
    color: #ffffff;
    background: var(--wis-navy);
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: background 160ms ease;
  }

  .form-actions button:hover:not(:disabled) {
    background: var(--wis-blue);
  }

  .form-actions button:disabled {
    cursor: not-allowed;
    opacity: 0.62;
  }

  .button-arrow {
    color: var(--wis-ice);
    font-size: 1.1rem;
  }

  .form-status {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.8rem 1.15rem;
    color: var(--wis-muted);
    background: var(--wis-paper);
    font-size: 0.79rem;
    line-height: 1.5;
  }

  .form-status[data-state='success'] {
    color: #176345;
  }

  .form-status[data-state='error'] {
    color: #9b2f2f;
  }

  @media (max-width: 900px) {
    .contact-shell {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-details {
      position: static;
    }

    .contact-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (max-width: 620px) {
    .form-grid,
    .contact-list {
      grid-template-columns: 1fr;
    }

    .form-field-wide {
      grid-column: auto;
    }

    .form-heading {
      display: block;
    }

    .form-heading > p {
      margin-top: 1rem;
    }

    .form-actions {
      grid-template-columns: 1fr;
      border-left: 1px solid var(--wis-line);
    }

    .form-actions button {
      border-right: 0;
    }
  }
</style>
