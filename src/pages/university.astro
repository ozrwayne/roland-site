---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="高校合作" description="国际医学教育合作伙伴 - Roland Wayne" lang="zh">
  <section class="pt-32 pb-20 bg-gradient-to-b from-secondary to-primary">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-accent uppercase tracking-[0.3em] text-sm mb-4">国际医学教育合作伙伴</p>
      <h1 class="font-serif text-4xl md:text-5xl mb-6">高校合作</h1>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-16 xl:gap-20 items-start">
        <div class="md:col-span-1 bio-photo">
          <img src="/profile.jpg" alt="Roland Wayne" class="w-full aspect-[3/4] object-cover rounded-lg shadow-lg" />
        </div>
        <div class="md:col-span-2 bio-copy">
          <h2 class="font-serif text-2xl mb-6">个人简介</h2>
          <p class="text-text-secondary leading-relaxed mb-8">
            Roland专注于心血管疾病、糖尿病等慢性病的卫生经济研究与临床数据建模，同时也是医学领域BSS服务体系搭建者、操盘者与推动者。Roland已经在医学升学赛道深耕多年，目前已经建立非常完善的个人IP系统。
          </p>
          <div class="space-y-3">
            {[
              '澳大利亚昆士兰大学医学院博士候选人（全额奖学金）',
              '澳大利亚昆士兰大学斯普林菲尔德健康福祉研究中心成员',
              '邦德大学医学院临床模拟教学团队成员',
              '昆士兰大学卫生经济学硕士',
              '澳大利亚潮汕青年会执行会长',
              '澳大利亚潮汕同乡会副会长',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <span class="text-accent mt-1">▸</span>
                <span class="text-text-secondary">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-secondary">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-serif text-2xl text-center mb-12">核心成就</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { value: '600+', title: '全球顶尖高校', subtitle: '录取案例' },
          { value: '3+', title: '连续数年', subtitle: '香港/英国/澳洲医学院录取' },
          { value: '6+', title: '服务时长', subtitle: '年行业经验' },
          { value: '30万+', title: '内部培训', subtitle: '字培训资料' },
        ].map((item) => (
          <div class="text-center">
            <div class="font-serif text-4xl md:text-5xl text-accent mb-2">{item.value}</div>
            <div class="font-medium mb-1">{item.title}</div>
            <div class="text-text-muted text-sm">{item.subtitle}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="responsibilities-section">
    <div class="university-shell">
      <h2 class="section-title centered-title">工作职责</h2>
      <div class="responsibilities-grid">
        {[
          { title: '团队管理', desc: '全面负责导师团队的组建、管理与人才发展机制设计' },
          { title: '体系搭建', desc: '自主开发服务流程标准化体系和智能化文书评价系统' },
          { title: '项目统筹', desc: '统筹管理医学本硕博申请全流程' },
          { title: '知识建设', desc: '主导内部知识库建设与应用场景课程开发' },
          { title: 'AI科研体系构建', desc: '为高校和科研机构搭建AI驱动的科研工作流与知识管理系统' },
          { title: 'AI科研教学', desc: '面向医学领域的AI工具应用培训，手把手带团队跑通真实科研场景' },
          { title: 'AI医学研究', desc: '将AI技术应用于医学研究全流程，包括文献检索、数据分析、论文写作等' },
        ].map((item) => (
          <article class="responsibility-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="expertise-section">
    <div class="university-shell">
      <h2 class="section-title centered-title">专业领域</h2>
      <div class="expertise-grid">
        {[
          '卫生经济学研究',
          '临床数据建模',
          '医学升学咨询',
          '项目管理与团队运营',
          '中国市场准入咨询',
          'AI科研体系构建',
          'AI科研教学',
          'AI医学研究',
        ].map((tag) => (
          <span class="expertise-item">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-serif text-2xl mb-4">合作咨询</h2>
      <p class="text-text-secondary mb-8">欢迎各大海外高等教育机构及私营医疗企业洽谈合作</p>
      <a href="/contact" class="inline-block px-8 py-4 bg-accent text-primary font-medium text-sm uppercase tracking-wider hover:bg-accent-hover transition-colors">
        联系我
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .university-shell {
    width: min(100%, 68rem);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }

  .bio-copy {
    padding-left: 2.5rem;
  }

  .bio-photo {
    padding-top: 3.5rem;
  }

  .section-title {
    margin: 0;
    color: var(--wis-navy);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .centered-title {
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    text-align: center;
  }

  .responsibilities-section {
    padding-block: clamp(5rem, 8vw, 8rem);
    background: var(--wis-paper);
    border-bottom: 1px solid var(--wis-line);
  }

  .responsibilities-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .responsibility-card {
    min-height: 12.5rem;
    padding: clamp(1.5rem, 2.3vw, 2.25rem);
    background: #ffffff;
    border: 1px solid var(--wis-line);
  }

  .responsibility-card:last-child {
    grid-column: 2;
  }

  .responsibility-card h3 {
    margin: 0 0 1rem;
    color: var(--wis-navy);
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .responsibility-card p {
    margin: 0;
    color: var(--wis-copy);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .expertise-section {
    padding-block: clamp(5rem, 8vw, 8rem);
    background: var(--wis-surface);
    border-bottom: 1px solid var(--wis-line);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    gap: 1rem;
    justify-content: center;
  }

  .expertise-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.75rem;
    padding: 0.8rem 1.35rem;
    color: var(--wis-navy);
    background: rgb(255 255 255 / 58%);
    border: 1px solid #b9c9dc;
    font-size: 1rem;
    font-weight: 520;
    line-height: 1.55;
  }

  @media (max-width: 1000px) {
    .responsibilities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .responsibility-card:last-child {
      grid-column: auto;
    }

    .expertise-grid {
      grid-template-columns: repeat(2, max-content);
    }
  }

  @media (max-width: 720px) {
    .bio-photo {
      padding-top: 0;
    }

    .bio-copy {
      padding-left: 0;
    }

    .responsibilities-grid {
      grid-template-columns: 1fr;
    }

    .responsibility-card {
      min-height: auto;
    }
  }

  @media (max-width: 480px) {
    .expertise-grid {
      grid-template-columns: 1fr;
      width: min(100%, 22rem);
      margin-inline: auto;
    }

    .expertise-item {
      min-height: 3.5rem;
    }
  }
</style>
