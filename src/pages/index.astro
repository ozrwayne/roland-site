---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const publishedPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

const latestPosts = publishedPosts.slice(0, 5);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title="关于"
  description="Roland Wayne — 昆士兰大学医学院博士候选人、独立写作者与 AI 系统实践者。用跨学科思维拆解复杂问题。"
  image="/images/blog/welcome/cover.png"
  lang="zh"
>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">研究者 · 系统构建者 · 跨界领域思考者</p>
      <h1 id="hero-title">
        <span>用跨学科思维</span>
        <span class="hero-title-contrast">拆解复杂问题</span>
      </h1>
      <p class="hero-description">
        昆士兰大学医学院博士候选人，AI 领域内容创作者。在 Springfield 研究低钠盐替代品的心血管疾病预防经济学，同时探索 AI 如何重塑研究与创作。
      </p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <img class="hero-planes" src="/brand/hero-planes.png" alt="" width="1536" height="1024" />
      <img class="hero-logo" src="/brand/wis-logo-dark.png" alt="" width="1334" height="375" />
    </div>
  </section>

  <section class="latest-section" aria-labelledby="latest-title">
    <div class="section-shell latest-shell">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Writing / Latest</p>
          <h2 id="latest-title">最新文章</h2>
        </div>
        <a href="/blog" class="text-link">
          查看全部文章
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      {latestPosts.length > 0 ? (
        <ol class="article-timeline">
          {latestPosts.map((post) => (
            <li>
              <span class="timeline-marker" aria-hidden="true"></span>
              <a class="article-card" href={`/blog/${post.id}`}>
                <img
                  src={post.data.cover ?? post.data.image ?? '/images/blog/welcome/cover.png'}
                  alt={post.data.coverAlt ?? ''}
                  width="240"
                  height="150"
                  loading="lazy"
                />
                <span class="article-copy">
                  <span class="article-meta">
                    <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
                    {post.data.pinned && <span class="pinned-label">置顶</span>}
                  </span>
                  <span class="article-title">{post.data.title}</span>
                  <span class="article-description">{post.data.description}</span>
                </span>
                <i class="ph ph-arrow-up-right article-arrow" aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">文章正在整理中。</p>
      )}
    </div>
  </section>

  <section class="practice-section" aria-labelledby="practice-title">
    <div class="section-shell">
      <div class="section-intro">
        <p class="section-kicker">About / Practice</p>
        <h2 id="practice-title">工作与实践</h2>
        <p>研究现实问题，写下经过验证的判断，再把方法构建成可持续运行的系统。</p>
      </div>

      <div class="practice-grid">
        <article>
          <i class="ph ph-books" aria-hidden="true"></i>
          <h3>学术研究</h3>
          <p>昆士兰大学医学院博士候选人，在 Springfield Healthy Hearts 项目中研究低钠盐替代品在心血管疾病预防中的健康经济学，关注政策如何真正落地。</p>
          <a href="/research">查看研究 <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </article>
        <article>
          <i class="ph ph-pencil-line" aria-hidden="true"></i>
          <h3>独立写作</h3>
          <p>写宏观经济、AI 趋势、决策哲学。不贩卖焦虑，不追热点，只写经过深度思考的东西。</p>
          <a href="/blog">阅读文章 <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </article>
        <article>
          <i class="ph ph-circles-three-plus" aria-hidden="true"></i>
          <h3>系统构建</h3>
          <p>用 AI 构建个人数字分身系统，实践自动化工作流、知识管理和投资决策框架。相信复利，相信系统。</p>
          <a href="/services">了解服务 <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </article>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-cta" aria-labelledby="contact-title">
    <div class="cta-content">
      <p class="section-kicker">Collaboration / Contact</p>
      <h2 id="contact-title">想聊聊？</h2>
      <p>无论是学术合作、内容探讨，还是对 AI 系统构建感兴趣，欢迎联系。</p>
      <a href="/contact">
        联系我
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 30.5rem;
    overflow: hidden;
    background: var(--wis-paper);
    border-bottom: 1px solid var(--wis-line);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: 52%;
    min-height: 30.5rem;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3.5rem, 6vw, 6.2rem) clamp(2.5rem, 5vw, 5.8rem);
  }

  .eyebrow,
  .section-kicker {
    margin: 0;
    color: var(--wis-blue);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 11em;
    margin: 1.3rem 0 1.35rem;
    color: var(--wis-navy);
    font-size: clamp(2.8rem, 4.15vw, 4.05rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .hero-copy h1 span {
    display: block;
  }

  .hero-title-contrast {
    color: #111318;
  }

  .hero-description {
    max-width: 38rem;
    margin: 0;
    color: var(--wis-copy);
    font-size: clamp(0.98rem, 1.3vw, 1.16rem);
    line-height: 1.9;
  }

  .hero-art {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    background: var(--wis-paper);
    pointer-events: none;
  }

  .hero-planes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .hero-logo {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 75%;
    width: min(49%, 42rem);
    height: auto;
    transform: translate(-50%, -50%);
    mix-blend-mode: multiply;
  }

  .section-shell {
    width: min(100%, 70rem);
    margin: 0 auto;
    padding: clamp(4rem, 7vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  }

  .latest-section {
    background: var(--wis-paper);
  }

  .latest-shell {
    padding-top: clamp(3.4rem, 6vw, 5.5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.2rem;
  }

  .section-heading h2,
  .section-intro h2,
  .contact-cta h2 {
    margin: 0.55rem 0 0;
    color: var(--wis-navy);
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--wis-blue);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .article-timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 2.75rem;
    list-style: none;
  }

  .article-timeline::before {
    position: absolute;
    top: 1.45rem;
    bottom: 1.45rem;
    left: 0.42rem;
    width: 1px;
    background: #bfd0e2;
    content: '';
  }

  .article-timeline > li {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    z-index: 1;
    top: 1.62rem;
    left: -2.7rem;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--wis-paper);
    border: 2px solid var(--wis-blue);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--wis-paper);
  }

  .article-timeline > li:first-child .timeline-marker {
    background: var(--wis-ice);
  }

  .article-card {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) 1.5rem;
    gap: 1.5rem;
    align-items: center;
    min-height: 8.4rem;
    padding: 1.25rem 0;
    color: inherit;
    border-bottom: 1px solid var(--wis-line);
    text-decoration: none;
  }

  .article-card > img {
    width: 9.5rem;
    height: 5.95rem;
    object-fit: fill;
    background: var(--wis-surface);
    border: 1px solid var(--wis-line);
  }

  .article-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--wis-muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .pinned-label {
    padding: 0.08rem 0.4rem;
    color: var(--wis-navy);
    background: var(--wis-ice);
    font-size: 0.66rem;
    font-weight: 650;
  }

  .article-title {
    margin-top: 0.38rem;
    color: var(--wis-navy);
    font-size: clamp(1rem, 1.6vw, 1.27rem);
    font-weight: 650;
    line-height: 1.35;
    transition: color 150ms ease;
  }

  .article-description {
    display: -webkit-box;
    margin-top: 0.45rem;
    overflow: hidden;
    color: var(--wis-copy);
    font-size: 0.84rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .article-arrow {
    color: var(--wis-muted);
    font-size: 1.15rem;
    transition: color 150ms ease, transform 150ms ease;
  }

  .article-card:hover .article-title,
  .article-card:hover .article-arrow {
    color: var(--wis-blue);
  }

  .article-card:hover .article-arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  .empty-state {
    color: var(--wis-copy);
  }

  .practice-section {
    background: var(--wis-paper);
    border-top: 1px solid var(--wis-line);
  }

  .section-intro {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .section-intro > p:last-child {
    margin: 1.15rem 0 0;
    color: var(--wis-copy);
    font-size: 1rem;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #bdcfe1;
    border-bottom: 1px solid #bdcfe1;
  }

  .practice-grid article {
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    padding: 2.2rem clamp(1.5rem, 2.6vw, 2.5rem);
  }

  .practice-grid article + article {
    border-left: 1px solid #bdcfe1;
  }

  .practice-grid > article > i {
    color: var(--wis-blue);
    font-size: 1.75rem;
  }

  .practice-grid h3 {
    margin: 1.5rem 0 0.8rem;
    color: var(--wis-navy);
    font-size: 1.2rem;
    font-weight: 650;
  }

  .practice-grid p {
    margin: 0;
    color: var(--wis-copy);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  .practice-grid a {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding: 1.5rem 0 0.08rem;
    color: var(--wis-blue);
    border-bottom: 1px solid transparent;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .practice-grid a:hover {
    border-bottom-color: currentColor;
  }

  .contact-cta {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6.5rem);
    background: var(--wis-paper);
    color: var(--wis-navy);
    border-top: 1px solid var(--wis-line);
    text-align: center;
  }

  .cta-content {
    display: flex;
    width: min(100%, 48rem);
    margin: 0 auto;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-cta .section-kicker {
    color: var(--wis-blue);
  }

  .contact-cta h2 {
    color: var(--wis-navy);
    font-size: clamp(2.4rem, 5vw, 4.25rem);
  }

  .contact-cta p:not(.section-kicker) {
    margin: 1.2rem 0 0;
    color: var(--wis-copy);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
  }

  .contact-cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2.1rem;
    padding: 0.82rem 1.25rem;
    color: #ffffff;
    background: var(--wis-navy);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .contact-cta a:hover {
    background: var(--wis-blue);
    transform: translateY(-2px);
  }

  @media (max-width: 1180px) {
    .hero-copy {
      width: 55%;
      padding-inline: 3rem;
    }

    .hero-logo {
      left: 76.5%;
      width: min(47%, 34rem);
    }
  }

  @media (max-width: 980px) {
    .hero-copy h1 {
      font-size: clamp(2.55rem, 5.5vw, 3.6rem);
    }

    .practice-grid {
      grid-template-columns: 1fr;
    }

    .practice-grid article {
      min-height: auto;
    }

    .practice-grid article + article {
      border-top: 1px solid #bdcfe1;
      border-left: 0;
    }

    .practice-grid a {
      margin-top: 1.5rem;
      padding-top: 0;
    }
  }

  @media (max-width: 760px) {
    .home-hero {
      display: flex;
      min-height: 0;
      flex-direction: column;
      overflow: visible;
    }

    .hero-copy {
      width: 100%;
      min-height: 0;
      padding: 4rem 1.5rem 3.2rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.7rem, 13vw, 4.3rem);
    }

    .hero-art {
      position: relative;
      min-height: 15rem;
      border-top: 1px solid var(--wis-line);
    }

    .hero-logo {
      left: 50%;
      width: min(82%, 30rem);
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .article-timeline {
      padding-left: 1.7rem;
    }

    .article-timeline::before {
      left: 0.3rem;
    }

    .timeline-marker {
      left: -1.7rem;
    }

    .article-card {
      grid-template-columns: 6.3rem minmax(0, 1fr);
      gap: 1rem;
      min-height: 7.5rem;
    }

    .article-card > img {
      width: 6.3rem;
      height: 4.45rem;
    }

    .article-description,
    .article-arrow {
      display: none;
    }

    .contact-cta {
      text-align: left;
    }
  }

  @media (max-width: 430px) {
    .article-card {
      grid-template-columns: 1fr;
      gap: 0.7rem;
      padding-block: 1.2rem;
    }

    .article-card > img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
