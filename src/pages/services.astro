---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('zh');
---

<BaseLayout
  title="服务"
  description="Wayne Insight Spring —— 国际医学教育咨询服务。"
  lang="zh"
>
  <PageHero
    kicker="Services / Consulting"
    title="服务"
    subtitle={t.services.subtitle}
  />

  <section class="py-20">
    <div class="services-shell">
      <!-- Philosophy -->
      <div class="bg-secondary border border-border p-8 mb-16">
        <p class="font-serif text-accent text-lg mb-4">{t.services.philosophy}</p>
        <p class="text-text-secondary leading-relaxed">{t.services.philosophyDesc}</p>
      </div>

      <!-- Service Cards -->
      <div class="space-y-8 mb-16">

        <!-- Service 1 -->
        <div class="p-8 border border-border hover:border-accent/40 transition-colors">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
            <h3 class="text-xl font-medium text-text-primary">{t.services.s1.title}</h3>
            <span class="text-accent font-serif text-lg">{t.services.s1.tier}</span>
          </div>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">{t.services.s1.desc}</p>
          <div class="flex flex-wrap gap-2">
            {t.services.s1.tags.map((tag: string) => (
              <span class="text-xs text-text-muted border border-border px-2 py-1">{tag}</span>
            ))}
          </div>
        </div>

        <!-- Service 2 -->
        <div class="p-8 border border-border hover:border-accent/40 transition-colors">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
            <h3 class="text-xl font-medium text-text-primary">{t.services.s2.title}</h3>
            <span class="text-accent font-serif text-lg">{t.services.s2.tier}</span>
          </div>
          <p class="text-text-secondary text-sm leading-relaxed mb-4">{t.services.s2.desc}</p>
          <div class="flex flex-wrap gap-2">
            {t.services.s2.tags.map((tag: string) => (
              <span class="text-xs text-text-muted border border-border px-2 py-1">{tag}</span>
            ))}
          </div>
        </div>

      </div>

      <!-- CTA -->
      <div class="text-center py-12">
        <p class="text-text-secondary mb-6">{t.services.ctaText}</p>
        <a href="/contact" class="inline-block px-8 py-4 bg-accent text-primary font-medium text-sm uppercase tracking-wider hover:bg-accent-hover transition-colors">
          {t.services.ctaButton}
        </a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .services-shell {
    width: min(100%, 68rem);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }
</style>
