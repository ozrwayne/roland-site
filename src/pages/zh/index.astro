---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');
---

<BaseLayout
  title="首页"
  description="Roland Wayne — 健康实施科学博士研究员，Wayne Insight Spring 创始人，帮助家庭做出国际医学教育决策。"
  lang="zh"
>
  <section class="min-h-[85vh] flex items-center bg-secondary">
    <div class="max-w-6xl mx-auto px-6 py-20 w-full">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-accent uppercase tracking-[0.3em] text-sm mb-4 font-medium">{t.hero.tagline}</p>
          <h1 class="font-serif text-4xl md:text-6xl leading-tight mb-6 text-text-primary">
            {t.hero.title1}<br />
            <span class="text-accent">{t.hero.titleHighlight}</span><br />
            {t.hero.title2}
          </h1>
          <p class="text-text-secondary text-lg leading-relaxed mb-8 max-w-lg">{t.hero.description}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/zh/services" class="px-6 py-3 bg-accent text-white font-medium text-sm uppercase tracking-wider hover:bg-accent-hover transition-colors text-center">{t.hero.cta1}</a>
            <a href="/zh/research" class="px-6 py-3 border border-accent text-accent text-sm uppercase tracking-wider hover:bg-accent hover:text-white transition-colors text-center">{t.hero.cta2}</a>
          </div>
        </div>
        <div class="hidden md:block">
          <div class="aspect-[3/4] bg-tertiary border border-border flex items-center justify-center rounded-sm overflow-hidden">
            <p class="text-text-muted text-sm">Profile Photo</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-primary">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 border border-border hover:border-accent/40 transition-colors rounded-sm">
          <div class="text-accent text-3xl font-serif mb-4">01</div>
          <h3 class="text-lg font-medium mb-3 text-text-primary">{t.pillars.research.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{t.pillars.research.description}</p>
        </div>
        <div class="p-8 border border-border hover:border-accent/40 transition-colors rounded-sm">
          <div class="text-accent text-3xl font-serif mb-4">02</div>
          <h3 class="text-lg font-medium mb-3 text-text-primary">{t.pillars.consulting.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{t.pillars.consulting.description}</p>
        </div>
        <div class="p-8 border border-border hover:border-accent/40 transition-colors rounded-sm">
          <div class="text-accent text-3xl font-serif mb-4">03</div>
          <h3 class="text-lg font-medium mb-3 text-text-primary">{t.pillars.knowledge.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{t.pillars.knowledge.description}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-secondary">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-serif text-3xl mb-6 text-text-primary">{t.cta.title}</h2>
      <p class="text-text-secondary mb-8 text-lg">{t.cta.description}</p>
      <a href="/zh/contact" class="inline-block px-8 py-4 bg-accent text-white font-medium text-sm uppercase tracking-wider hover:bg-accent-hover transition-colors">{t.cta.button}</a>
    </div>
  </section>
</BaseLayout>
