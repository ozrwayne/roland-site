---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');
---

<BaseLayout title="联系" description="联系 Roland Wayne 进行研究合作或教育咨询。" lang="zh">
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-accent uppercase tracking-[0.3em] text-sm mb-4">{t.contact.eyebrow}</p>
      <h1 class="font-serif text-4xl md:text-5xl text-text-primary mb-6">{t.contact.title}</h1>
      <p class="text-text-secondary text-lg mb-16 max-w-2xl">{t.contact.subtitle}</p>

      <div class="grid md:grid-cols-2 gap-16">
        <div class="space-y-8">
          <div>
            <h3 class="text-sm uppercase tracking-wider text-text-muted mb-2">{t.contact.email}</h3>
            <a href="mailto:contact@rolandwayne.com" class="text-accent hover:text-accent-hover transition-colors">contact@rolandwayne.com</a>
          </div>
          <div>
            <h3 class="text-sm uppercase tracking-wider text-text-muted mb-2">{t.contact.location}</h3>
            <p class="text-text-secondary">{t.contact.locationValue}</p>
          </div>
          <div>
            <h3 class="text-sm uppercase tracking-wider text-text-muted mb-2">{t.contact.affiliation}</h3>
            <p class="text-text-secondary">{t.contact.affiliationValue}</p>
          </div>
          <div>
            <h3 class="text-sm uppercase tracking-wider text-text-muted mb-2">{t.contact.company}</h3>
            <p class="text-text-secondary">{t.contact.companyValue}</p>
          </div>
        </div>
        <div class="bg-secondary border border-border p-8">
          <p class="text-text-secondary text-sm mb-6">{t.contact.formPlaceholder}</p>
          <a href="mailto:contact@rolandwayne.com" class="inline-block px-6 py-3 bg-accent text-white font-medium text-sm uppercase tracking-wider hover:bg-accent-hover transition-colors">{t.contact.sendEmail}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
