---
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { getPublishedBlogPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.source === 'markdown' ? (await render(post.entry)).Content : null;
const contentHtml = post.source === 'wordpress' ? post.contentHtml : '';
---

<BlogPost
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  tags={post.tags}
  cover={post.cover}
  coverAlt={post.coverAlt}
>
  {Content ? <Content /> : <Fragment set:html={contentHtml} />}
</BlogPost>
