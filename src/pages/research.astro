---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('zh');
---

<BaseLayout
  title="研究"
  description="健康实施科学、心血管疾病预防与离散选择实验方向研究。"
  lang="zh"
>
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">

      <!-- Eyebrow + Title + Subtitle -->
      <p class="text-accent uppercase tracking-[0.3em] text-sm mb-4">{t.research.eyebrow}</p>
      <h1 class="font-serif text-4xl md:text-5xl text-text-primary mb-6">{t.research.title}</h1>
      <p class="text-text-secondary text-lg leading-relaxed max-w-2xl mb-16">{t.research.subtitle}</p>

      <!-- Current Research Card -->
      <div class="mb-16">
        <h2 class="font-serif text-xl text-text-secondary uppercase tracking-widest mb-6">{t.research.current}</h2>
        <div class="border border-border bg-secondary rounded-sm p-8 hover:border-accent/40 transition-colors">
          <h3 class="font-serif text-2xl text-text-primary mb-4">{t.research.currentTitle}</h3>
          <p class="text-text-secondary leading-relaxed mb-6">{t.research.currentDesc}</p>
          <div class="flex flex-wrap gap-2">
            {t.research.tags.map((tag: string) => (
              <span class="text-accent border border-accent/30 bg-primary text-sm px-3 py-1 rounded-sm">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Publications -->
      <div class="mb-16">
        <h2 class="font-serif text-xl text-text-secondary uppercase tracking-widest mb-6">{t.research.publications}</h2>
        <div class="space-y-4">
          {[t.research.pub1, t.research.pub2].map((pub: { type: string; title: string; desc: string }) => (
            <div class="border border-border bg-secondary rounded-sm p-6 hover:border-accent/40 transition-colors">
              <p class="text-accent text-xs uppercase tracking-widest mb-2">{pub.type}</p>
              <h3 class="font-serif text-lg text-text-primary mb-2">{pub.title}</h3>
              <p class="text-text-secondary text-sm">{pub.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Interests Grid -->
      <div>
        <h2 class="font-serif text-xl text-text-secondary uppercase tracking-widest mb-6">{t.research.interests}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {t.research.interestList.map((interest: string) => (
            <div class="border border-border bg-secondary rounded-sm px-4 py-3 hover:border-accent/40 transition-colors">
              <p class="text-text-primary text-sm">{interest}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
