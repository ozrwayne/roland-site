---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  lang?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  cover,
  coverAlt = '',
  lang = 'zh',
} = Astro.props;

const htmlLang = lang === 'zh' ? 'zh-CN' : lang;
const formatter = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const category = tags[0] ?? (lang === 'zh' ? '文章' : 'Article');

const navLinks = [
  { label: 'About', href: '/#about' },
  { label: 'Article', href: '/#articles', active: true },
  { label: 'Signal', href: '/#signaling' },
  { label: 'Video', href: '/#video' },
  { label: 'Building', href: '/#building' },
  { label: 'Collaboration', href: '/#collaborating' },
];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <SEO title={title} description={description} image={cover} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="stylesheet" href="/vendor/phosphor/style.css" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/anthropic-sans.woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#article-content">跳到文章正文</a>

    <header class="article-site-header">
      <div class="header-primary">
        <a class="brand" href="/#about" aria-label="Roland Wayne 首页">
          <img src="/assets/roland-avatar-original.png" alt="" width="40" height="40" />
          <span aria-hidden="true">RW</span>
          <span class="sr-only">Roland Wayne</span>
        </a>

        <nav class="desktop-nav" aria-label="网站导航">
          {navLinks.map((link) => (
            <a class:list={{ active: link.active }} href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>

        <a class="contact-link" href="/#contacting">Contact</a>
      </div>

      <nav class="mobile-nav" aria-label="移动端网站导航">
        {navLinks.map((link) => (
          <a class:list={{ active: link.active }} href={link.href} aria-current={link.active ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="article-content">
      <article class="post">
        <header class="post-header">
          <div class="post-heading">
            <p class="post-kicker">{category}</p>
            <h1>{title}</h1>
            <time class="post-date" datetime={pubDate.toISOString()}>{formatter.format(pubDate)}</time>
          </div>
        </header>

        {cover && (
          <figure class="cover-wrap">
            <img
              src={cover}
              alt={coverAlt}
              width="1536"
              height="1024"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
        )}

        <div class="post-body prose prose-lg max-w-none">
          <slot />
        </div>

        <footer class="post-end">
          <a href="/blog">← 返回全部文章</a>
          <a href="/#contacting">联系 Roland →</a>
        </footer>
      </article>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: 'RW Article Sans';
    src: url('/assets/anthropic-sans.woff2') format('woff2');
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
  }

  :global(:root) {
    --article-bg: #f7f6f2;
    --article-ink: #171613;
    --article-copy: #4e4941;
    --article-muted: #746b5f;
    --article-line: #d9d3c8;
    --article-accent: #a64b34;
    --article-display: 'Iowan Old Style', Baskerville, Georgia, 'Times New Roman', serif;
    --article-serif: 'Songti SC', 'Noto Serif SC', STSong, SimSun, serif;
    --article-sans: 'RW Article Sans', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }

  :global(html) {
    background: var(--article-bg);
    color: var(--article-ink);
  }

  :global(body) {
    min-width: 320px;
    margin: 0;
    background: var(--article-bg);
    color: var(--article-ink);
    font-family: var(--article-serif);
    line-height: 1.8;
  }

  :global(body::before) {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: 2px;
    background: var(--article-accent);
    content: '';
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    color: inherit;
    text-underline-offset: 0.22em;
  }

  :global(:focus-visible) {
    outline: 3px solid rgba(166, 75, 52, 0.45);
    outline-offset: 4px;
  }

  :global(::selection) {
    color: #ffffff;
    background: var(--article-accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 1rem;
    z-index: 200;
    padding: 0.65rem 0.9rem;
    color: var(--article-accent);
    background: var(--article-bg);
    border: 1px solid var(--article-accent);
    font-family: var(--article-sans);
    text-decoration: none;
    transform: translateY(-180%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .article-site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    width: 100%;
    background: var(--article-bg);
    border-bottom: 1px solid rgba(116, 107, 95, 0.22);
  }

  .header-primary {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    width: min(100% - 3rem, 75rem);
    min-height: 82px;
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: max-content;
    color: var(--article-ink);
    font-family: var(--article-display);
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand img {
    width: 2.2rem;
    height: 2.2rem;
    object-fit: cover;
    border-radius: 50%;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1rem, 2vw, 1.8rem);
    font-family: var(--article-sans);
    font-size: 0.88rem;
  }

  .desktop-nav a,
  .mobile-nav a {
    position: relative;
    color: var(--article-copy);
    text-decoration: none;
  }

  .desktop-nav a::after,
  .mobile-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.6rem;
    left: 0;
    height: 1px;
    background: var(--article-accent);
    content: '';
    transform: scaleX(0);
  }

  .desktop-nav a:hover,
  .desktop-nav a.active,
  .mobile-nav a.active {
    color: var(--article-accent);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.active::after,
  .mobile-nav a.active::after {
    transform: scaleX(1);
  }

  .contact-link {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    padding: 0 1.55rem;
    color: #ffffff;
    background: var(--article-ink);
    border-radius: 0.75rem;
    font-family: var(--article-sans);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .mobile-nav {
    display: none;
  }

  .post {
    width: 100%;
    padding-bottom: clamp(4.5rem, 8vw, 8rem);
  }

  .post-header {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .post-heading {
    width: min(100% - 3rem, 70rem);
    margin: 0 auto;
    text-align: center;
  }

  .post-kicker {
    margin: 0;
    color: var(--article-accent);
    font-family: var(--article-sans);
    font-size: 0.82rem;
    font-weight: 720;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .post-heading h1 {
    max-width: 68rem;
    margin: clamp(1.15rem, 2.4vw, 1.8rem) auto 0;
    color: var(--article-ink);
    font-family: var(--article-display), var(--article-serif);
    font-size: clamp(2.8rem, 5vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .post-date {
    display: block;
    margin-top: clamp(1.7rem, 3vw, 2.5rem);
    color: var(--article-muted);
    font-family: var(--article-sans);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .cover-wrap {
    width: min(100% - 3rem, 68rem);
    margin: 0 auto clamp(4rem, 7vw, 6rem);
  }

  .cover-wrap img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: clamp(1rem, 2vw, 1.75rem);
  }

  .post-body,
  .post-end {
    width: min(100% - 3rem, 48rem);
    margin-inline: auto;
  }

  .post-body {
    color: var(--article-copy);
    font-family: var(--article-serif);
    font-size: clamp(1.02rem, 1.2vw, 1.12rem);
    line-height: 2;
  }

  .post-body :global(> h1:first-child) {
    display: none;
  }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    color: var(--article-ink);
    font-family: var(--article-display), var(--article-serif);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .post-body :global(h2) {
    margin: 3.8rem 0 1.25rem;
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  .post-body :global(h3) {
    margin: 3rem 0 1rem;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-block: 1.25em;
  }

  .post-body :global(strong) {
    color: var(--article-ink);
    font-weight: 700;
  }

  .post-body :global(a) {
    color: var(--article-accent);
    text-decoration-thickness: 1px;
  }

  .post-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: clamp(2.5rem, 6vw, 4.5rem) auto;
  }

  .post-body :global(blockquote) {
    margin: 2.5rem 0;
    padding: 0 0 0 1.4rem;
    color: var(--article-ink);
    border-left: 2px solid var(--article-accent);
    font-size: 1.08em;
    font-style: normal;
  }

  .post-body :global(hr) {
    margin: 3.5rem 0;
    border: 0;
    border-top: 1px solid var(--article-line);
  }

  .post-body :global(code) {
    color: var(--article-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
  }

  .post-body :global(pre) {
    overflow-x: auto;
    padding: 1.25rem 1.4rem;
    color: #ffffff;
    background: var(--article-ink);
    border-radius: 0.8rem;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .post-body :global(pre code),
  .post-body :global(pre code *) {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff;
  }

  .post-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--article-sans);
    font-size: 0.88rem;
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: 0.75rem;
    border-bottom: 1px solid var(--article-line);
    text-align: left;
  }

  .post-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 1.35rem;
    color: var(--article-accent);
    border-top: 1px solid var(--article-line);
    font-family: var(--article-sans);
    font-size: 0.82rem;
    font-weight: 620;
  }

  .post-end a {
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .header-primary {
      grid-template-columns: 1fr auto;
      min-height: 68px;
    }

    .desktop-nav {
      display: none;
    }

    .contact-link {
      min-height: 2.7rem;
      padding-inline: 1.15rem;
    }

    .mobile-nav {
      display: flex;
      width: 100%;
      gap: 1.5rem;
      padding: 0.2rem 1.5rem 0.85rem;
      overflow-x: auto;
      color: var(--article-copy);
      font-family: var(--article-sans);
      font-size: 0.78rem;
      scrollbar-width: none;
    }

    .mobile-nav::-webkit-scrollbar {
      display: none;
    }

    .mobile-nav a {
      flex: 0 0 auto;
    }
  }

  @media (max-width: 640px) {
    .header-primary,
    .post-heading,
    .cover-wrap,
    .post-body,
    .post-end {
      width: min(100% - 2rem, 70rem);
    }

    .post-header {
      padding-top: 3rem;
    }

    .post-heading h1 {
      font-size: clamp(2.4rem, 10.5vw, 3.6rem);
      line-height: 1.08;
    }

    .post-end {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
