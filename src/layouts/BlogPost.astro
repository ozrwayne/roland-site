---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
}

const { title, description, pubDate, tags = [], cover, coverAlt = '' } = Astro.props;
const formatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={cover} lang="zh">
  <article class="post">
    <header class="post-header">
      <div class="post-shell">
        <a href="/blog" class="back-link"><i class="ph ph-arrow-left" aria-hidden="true"></i> 全部文章</a>
        <time datetime={pubDate.toISOString()}>{formatter.format(pubDate)}</time>
        <h1>{title}</h1>
        <p>{description}</p>
        {tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </div>
    </header>

    {cover && (
      <div class="cover-wrap">
        <img src={cover} alt={coverAlt} width="1536" height="1024" />
      </div>
    )}

    <div class="post-body prose prose-lg max-w-none">
      <slot />
    </div>

    <div class="post-end">
      <a href="/blog"><i class="ph ph-arrow-left" aria-hidden="true"></i> 返回全部文章</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  .post-shell,
  .post-body,
  .post-end,
  .cover-wrap {
    width: min(100%, 52rem);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .post-header {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
    background: #f9fbfd;
    border-bottom: 1px solid var(--wis-line);
  }

  .back-link,
  .post-end a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--wis-blue);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .post-header time {
    display: block;
    margin-top: 3rem;
    color: var(--wis-muted);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
  }

  .post-header h1 {
    margin: 0.85rem 0 1.2rem;
    color: var(--wis-navy);
    font-size: clamp(2.45rem, 6vw, 4.8rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .post-header p {
    max-width: 43rem;
    margin: 0;
    color: var(--wis-copy);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 1.75;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .tags span {
    padding: 0.22rem 0.55rem;
    color: var(--wis-blue);
    border: 1px solid var(--wis-line);
    font-size: 0.68rem;
  }

  .cover-wrap {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .cover-wrap img {
    display: block;
    width: 100%;
    max-height: 36rem;
    object-fit: cover;
    background: var(--wis-surface);
    border: 1px solid var(--wis-line);
  }

  .post-body {
    margin-top: clamp(3rem, 6vw, 5rem);
    color: #334a63;
    font-size: 1rem;
    line-height: 1.9;
  }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3) {
    color: var(--wis-navy);
    font-family: var(--font-sans);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .post-body :global(a) {
    color: var(--wis-blue);
  }

  .post-body :global(img) {
    border: 1px solid var(--wis-line);
  }

  .post-body :global(blockquote) {
    color: var(--wis-copy);
    border-left-color: var(--wis-ice);
  }

  .post-end {
    margin-top: clamp(3.5rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--wis-line);
  }
</style>
