---
interface Props {
  kicker: string;
  title: string;
  subtitle: string;
}

const { kicker, title, subtitle } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-shell">
    <p class="page-hero-kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="page-hero-subtitle">{subtitle}</p>
  </div>
</section>

<style>
  .page-hero-shell {
    width: min(100%, 68rem);
    margin: 0 auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }

  .page-hero {
    padding: clamp(3rem, 5vw, 4.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    background: var(--wis-paper);
    border-bottom: 1px solid var(--wis-line);
  }

  .page-hero-kicker {
    margin: 0;
    color: var(--wis-blue);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .page-hero h1 {
    margin: 0.65rem 0 0.55rem;
    color: var(--wis-navy);
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .page-hero-subtitle {
    margin: 0;
    color: var(--wis-copy);
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    letter-spacing: 0.01em;
  }
</style>
