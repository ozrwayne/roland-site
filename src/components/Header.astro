---
const currentPath = Astro.url.pathname;

const navLinks = [
  { text: '关于', href: '/', icon: 'ph-user' },
  { text: '文章', href: '/blog', icon: 'ph-article' },
  { text: '研究', href: '/research', icon: 'ph-flask' },
  { text: '服务', href: '/services', icon: 'ph-briefcase' },
  { text: '高校合作', href: '/university', icon: 'ph-bank' },
  { text: '联系', href: '/contact', icon: 'ph-envelope-simple' },
];

const isActive = (href: string) =>
  href === '/'
    ? currentPath === '/' || currentPath === '/about'
    : currentPath.startsWith(href);
---

<aside class="desktop-sidebar" aria-label="主导航">
  <div class="identity">
    <a href="/" class="portrait-link" aria-label="返回关于页">
      <img src="/profile.jpg" alt="Roland Wayne" width="144" height="144" />
    </a>
    <a href="/" class="name">Roland Wayne</a>
  </div>

  <nav class="sidebar-nav">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="active-dot" aria-hidden="true"></span>
            <i class={`ph ${link.icon}`} aria-hidden="true"></i>
            <span>{link.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

</aside>

<header class="mobile-header">
  <a href="/" class="mobile-brand">
    <img src="/profile.jpg" alt="" width="40" height="40" />
    <span>Roland Wayne</span>
  </a>
  <button id="mobile-menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开导航">
    <i class="ph ph-list menu-open-icon" aria-hidden="true"></i>
    <i class="ph ph-x menu-close-icon" aria-hidden="true"></i>
  </button>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <nav aria-label="移动端主导航">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['mobile-nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <i class={`ph ${link.icon}`} aria-hidden="true"></i>
            <span>{link.text}</span>
            {isActive(link.href) && <span class="mobile-active-dot" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  const closeMenu = () => {
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', '打开导航');
    menu.hidden = true;
    document.body.classList.remove('menu-open');
  };

  button?.addEventListener('click', () => {
    if (!menu) return;
    const nextOpen = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(nextOpen));
    button.setAttribute('aria-label', nextOpen ? '关闭导航' : '打开导航');
    menu.hidden = !nextOpen;
    document.body.classList.toggle('menu-open', nextOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900) closeMenu();
  });
</script>

<style>
  .desktop-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 50;
    display: flex;
    width: var(--sidebar-width);
    flex-direction: column;
    overflow-y: auto;
    background: var(--wis-navy);
    color: #ffffff;
    border-right: 1px solid rgba(163, 209, 224, 0.26);
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2.2rem, 5vh, 4rem) 1.6rem 2rem;
  }

  .portrait-link {
    display: block;
    width: clamp(6.5rem, 9.2vw, 8.8rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    background: #ffffff;
  }

  .portrait-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 23%;
  }

  .name {
    margin-top: 1.25rem;
    color: #ffffff;
    font-size: clamp(1rem, 1.3vw, 1.26rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .sidebar-nav {
    padding: 0.25rem 1.25rem;
  }

  .sidebar-nav ul,
  .mobile-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar-nav li + li {
    margin-top: 0.16rem;
  }

  .nav-link {
    position: relative;
    display: grid;
    grid-template-columns: 0.5rem 1.35rem 1fr;
    gap: 0.8rem;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.55rem 0.65rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.95rem;
    font-weight: 450;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.045);
  }

  .nav-link i {
    font-size: 1.35rem;
  }

  .active-dot {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: transparent;
  }

  .nav-link.active {
    color: #ffffff;
  }

  .nav-link.active .active-dot {
    background: var(--wis-ice);
    box-shadow: 0 0 0 3px rgba(163, 209, 224, 0.12);
  }

  .mobile-header,
  .mobile-menu {
    display: none;
  }

  @media (max-height: 740px) and (min-width: 900px) {
    .identity {
      padding-top: 1.4rem;
      padding-bottom: 1rem;
    }

    .portrait-link {
      width: 5.8rem;
    }

    .name {
      margin-top: 0.8rem;
    }

    .nav-link {
      min-height: 2.9rem;
    }

  }

  @media (max-width: 899px) {
    .desktop-sidebar {
      display: none;
    }

    .mobile-header {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 70;
      display: flex;
      height: 4.5rem;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.1rem;
      background: var(--wis-navy);
      border-bottom: 1px solid rgba(163, 209, 224, 0.25);
    }

    .mobile-brand {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      color: #ffffff;
      font-size: 0.98rem;
      font-weight: 600;
      text-decoration: none;
    }

    .mobile-brand img {
      width: 2.45rem;
      height: 2.45rem;
      object-fit: cover;
      object-position: 50% 23%;
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 50%;
    }

    #mobile-menu-button {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      padding: 0;
      color: #ffffff;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 50%;
      cursor: pointer;
    }

    #mobile-menu-button i {
      grid-area: 1 / 1;
      font-size: 1.4rem;
    }

    .menu-close-icon {
      display: none;
    }

    #mobile-menu-button[aria-expanded='true'] .menu-open-icon {
      display: none;
    }

    #mobile-menu-button[aria-expanded='true'] .menu-close-icon {
      display: block;
    }

    .mobile-menu {
      position: fixed;
      inset: 4.5rem 0 0 0;
      z-index: 65;
      padding: 1.2rem 1.25rem 2rem;
      overflow-y: auto;
      background: var(--wis-navy);
      color: #ffffff;
    }

    .mobile-menu:not([hidden]) {
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-link {
      display: flex;
      min-height: 3.75rem;
      align-items: center;
      gap: 0.9rem;
      padding: 0 0.75rem;
      color: rgba(255, 255, 255, 0.74);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      text-decoration: none;
    }

    .mobile-nav-link i {
      color: var(--wis-ice);
      font-size: 1.35rem;
    }

    .mobile-nav-link.active {
      color: #ffffff;
      font-weight: 600;
    }

    .mobile-active-dot {
      width: 0.38rem;
      height: 0.38rem;
      margin-left: auto;
      border-radius: 50%;
      background: var(--wis-ice);
    }

  }
</style>
