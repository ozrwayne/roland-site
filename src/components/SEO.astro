---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  tags?: string[];
  lang?: string;
}

const {
  title,
  description,
  image = '/images/blog/welcome/cover.png',
  imageAlt,
  canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.href,
  type = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  tags = [],
  lang = 'zh',
} = Astro.props;

const siteName = 'Roland Wayne';
const origin = Astro.site ?? Astro.url.origin;
const absoluteImage = image.startsWith('http') ? image : new URL(image, origin).href;
const resolvedImageAlt = imageAlt ?? `${siteName} — ${title}`;
const inLanguage = lang === 'zh' ? 'zh-CN' : lang;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const isLegacyRoute = Astro.url.pathname === '/zh/' || Astro.url.pathname.startsWith('/zh/');
const robotsDirective = isLegacyRoute ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const personId = 'https://www.rolandwayne.com/#person';
const websiteId = 'https://www.rolandwayne.com/#website';

const personSchema = {
  '@context': 'https://schema.org',
  '@id': personId,
  '@type': 'Person',
  name: 'Roland Wayne',
  alternateName: ['王罗湳', '罗湳', '罗湳Roland'],
  givenName: 'Roland',
  familyName: 'Wayne',
  email: 'mailto:contact@rolandwayne.com',
  url: 'https://www.rolandwayne.com',
  description: '澳洲昆士蘭大學醫學院全獎博士（醫學經濟學方向）。創辦 Wayne InsightSpring（AI 企業轉型諮詢，主攻中小企業）同 MedFlow（大健康留學）。將醫學經濟學評估方法論應用於 AI 落地與教育路徑設計。',
  jobTitle: ['Founder, Wayne InsightSpring', 'Founder, MedFlow', 'Principal Consultant'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'PhD Candidate, Health Economics',
    credentialCategory: 'doctoral candidate',
    competencyRequired: 'Health Economics',
    recognizedBy: {
      '@type': 'EducationalOrganization',
      name: 'University of Queensland Medical School',
      url: 'https://medicine.uq.edu.au',
    },
  },
  affiliation: {
    '@type': 'EducationalOrganization',
    name: 'University of Queensland Medical School',
    url: 'https://medicine.uq.edu.au',
  },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://wayneinsightspring.com/#organization',
    name: 'Wayne InsightSpring Limited',
  },
  sameAs: [
    'https://x.com/rwayne',
    'https://www.linkedin.com/in/roland-wayne-b3b179266',
    'https://orcid.org/0009-0002-4272-5854',
    'https://scholar.google.com/citations?user=ESmLe1MAAAAJ&hl=en',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: siteName,
  url: 'https://www.rolandwayne.com/',
  inLanguage: ['zh-CN', 'en'],
  author: { '@id': personId },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description,
  isPartOf: { '@id': websiteId },
  about: { '@id': personId },
  inLanguage,
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: absoluteImage,
    caption: resolvedImageAlt,
  },
};

const articleSchema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      '@id': `${canonicalURL}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      headline: title,
      description,
      image: [absoluteImage],
      url: canonicalURL,
      datePublished: publishedTime,
      dateModified: modifiedTime ?? publishedTime,
      author: { '@id': personId },
      inLanguage,
      ...(articleSection ? { articleSection } : {}),
      ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
    }
  : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0A1F5D" />
<meta name="color-scheme" content="light" />
<meta name="robots" content={robotsDirective} />
<meta name="author" content={siteName} />
<title>{title} | {siteName}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:title" content={`${title} | ${siteName}`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | ${siteName}`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.ico" sizes="32x32" />
<script id="schema-roland-person" type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
<script id="schema-roland-website" type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
<script id="schema-roland-webpage" type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
{articleSchema && <script id="schema-roland-article" type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}
