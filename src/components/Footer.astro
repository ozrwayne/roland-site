---
interface Props {
  lang?: string;
}

const { lang = 'zh' } = Astro.props;
const currentYear = new Date().getFullYear();

const siteLinks = [
  { label: '关于', href: '/' },
  { label: '全部文章', href: '/blog' },
  { label: '研究', href: '/research' },
  { label: '服务', href: '/services' },
  { label: '高校合作', href: '/university' },
  { label: '联系', href: '/contact' },
];

const profileLinks = [
  { label: 'Email', href: 'mailto:contact@rolandwayne.com' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/roland-wayne-b3b179266' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=ESmLe1MAAAAJ&hl=en' },
  { label: 'ORCID', href: 'https://orcid.org/0009-0002-4272-5854' },
  { label: 'X', href: 'https://x.com/rwayne' },
];

const friendLinks = [
  { label: 'MedFlow Education', href: 'https://medflowedu.com/' },
  { label: 'AusTEOS WA', href: 'https://austeoswa.com/' },
  { label: 'Wayne InsightSpring', href: 'https://www.wayneinsightspring.com/' },
];
---

<footer id="site-footer" class="site-footer" aria-label="网站页脚">
  <div class="footer-grid">
    <div class="footer-identity">
      <a href="/" class="footer-name">Roland Wayne</a>
      <p>博士候选人 · 健康实施科学 · 昆士兰大学</p>
      <p class="footer-note">研究、写作与 AI 系统实践。</p>
    </div>

    <nav aria-label="页脚导航">
      <h2>网站导航</h2>
      <ul>
        {siteLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2>个人主页</h2>
      <ul>
        {profileLinks.map((link) => (
          <li>
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'me noopener noreferrer' : undefined}>
              {link.label}
              {link.href.startsWith('http') && <i class="ph ph-arrow-up-right" aria-hidden="true"></i>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2>友情链接</h2>
      <ul>
        {friendLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} Roland Wayne. 保留所有权利。</p>
    <p>{lang === 'zh' ? 'Brisbane, Australia' : 'Brisbane, Australia'}</p>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 5.5rem) 1.6rem;
    background: #05070d;
    color: rgba(255, 255, 255, 0.7);
    border-top: 1px solid rgba(163, 209, 224, 0.28);
  }

  .footer-grid {
    display: grid;
    width: min(100%, 72rem);
    margin: 0 auto;
    grid-template-columns: minmax(15rem, 1.7fr) repeat(3, minmax(8rem, 1fr));
    gap: clamp(2rem, 4vw, 4.5rem);
  }

  .footer-name {
    display: inline-block;
    color: #ffffff;
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .footer-identity p {
    max-width: 22rem;
    margin: 0.72rem 0 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .footer-identity .footer-note {
    color: var(--wis-ice);
  }

  h2 {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.54rem;
  }

  li a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  li a:hover {
    color: var(--wis-ice);
  }

  li a i {
    font-size: 0.8rem;
  }

  .footer-bottom {
    display: flex;
    width: min(100%, 72rem);
    margin: clamp(2.8rem, 5vw, 4.25rem) auto 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.76rem;
  }

  @media (max-width: 1050px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .footer-grid > :last-child {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 680px) {
    .site-footer {
      padding-inline: 1.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.4rem 1.6rem;
    }

    .footer-identity {
      grid-column: 1 / -1;
    }

    .footer-grid > :last-child {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
