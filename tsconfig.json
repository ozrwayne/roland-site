{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["apps/**/*.js", "apps/**/*.jsx", "scripts/**/*.mjs", "worker/**/*.js"],
  "exclude": ["dist", "node_modules"]
}
